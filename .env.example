# SignalHire MCP Server — environment configuration
# Copy to .env and fill in. Never commit the result.

# ============================================================================
# REQUIRED — SignalHire API
# ============================================================================
# Single-tenant deployments use this key for everything. Multi-tenant BYOK
# deployments override it per tenant via SIGNALHIRE_TENANTS below.
SIGNALHIRE_API_KEY=your_signalhire_api_key_here

# ============================================================================
# REQUIRED — the public callback surface
# ============================================================================
# The externally reachable HTTPS base URL of THIS server. SignalHire POSTs
# reveal results to <base>/signalhire/callback/<tenant>?secret=<secret>.
#
# This is not a separate service. This process serves /mcp/ AND the callback
# on the same port. The previous architecture pointed at a different process,
# which is why results never reached the tools.
#
# Without this, every reveal is billed by SignalHire and then discarded.
SIGNALHIRE_PUBLIC_BASE_URL=https://signalhire.example.com

# Shared secret required on the callback URL. SignalHire sends no custom
# headers, so a query parameter is the only authentication channel available.
# Generate with: openssl rand -hex 32
SIGNALHIRE_CALLBACK_SECRET=generate_a_long_random_value

# ============================================================================
# REQUIRED for HTTP — who authenticates MCP callers
# ============================================================================
# The server refuses to serve HTTP without this, deliberately. Every reveal
# tool spends a credit, so an open endpoint is a way to bill your account.
#
#   platform  A gateway or reverse proxy in front authenticates first.
#   jwt       This server verifies bearer tokens itself. Required for
#             multi-tenant routing — the tenant comes from verified claims.
#   none      Nobody authenticates. Local development ONLY.
SIGNALHIRE_AUTH_MODE=platform

# Only for SIGNALHIRE_AUTH_MODE=jwt
# SIGNALHIRE_AUTH_JWKS_URI=https://issuer.example.com/.well-known/jwks.json
# SIGNALHIRE_AUTH_ISSUER=https://issuer.example.com/
# SIGNALHIRE_AUTH_AUDIENCE=signalhire-mcp
# SIGNALHIRE_AUTH_TENANT_CLAIM=tenant_id

# ============================================================================
# Durable inbox
# ============================================================================
# Where received callbacks are persisted before they are acknowledged. Must be
# on a volume that survives restarts and be writable by the service user — the
# server refuses to start otherwise, because a callback that cannot be stored
# is billed data loss.
SIGNALHIRE_DATA_DIR=/var/lib/signalhire-mcp

# ============================================================================
# Transport
# ============================================================================
SIGNALHIRE_TRANSPORT=http
SIGNALHIRE_HOST=0.0.0.0
SIGNALHIRE_PORT=8000
SIGNALHIRE_MCP_PATH=/mcp/

# FastMCP 4 validates Host/Origin against DNS-rebinding attacks. Behind a
# proxy, list the hostnames this server answers to or legitimate traffic is
# rejected. Comma-separated.
# SIGNALHIRE_ALLOWED_HOSTS=signalhire.example.com
# SIGNALHIRE_ALLOWED_ORIGINS=https://app.example.com

# ============================================================================
# Delivery — where enrichment results go
# ============================================================================
# JSON keyed by tenant id. Secrets are referenced by environment variable name
# (*_env), never inlined, so this value is safe to keep in a config file.
#
# Adapter types:
#   webhook  POST the normalised result to a URL (e.g. StaffHive).
#   mcp      Call a tool on another MCP server (e.g. the CATS MCP server).
#            This is how ATS writes happen — there is no vendor-specific code
#            in this repository, and adding Bullhorn or Greenhouse later means
#            another entry here, not another integration.
#
# SIGNALHIRE_TENANTS={"default":{"adapters":[{"type":"webhook","name":"staffhive","url":"https://staffhive.example.com/api/webhooks/signalhire/relay","secret_env":"STAFFHIVE_RELAY_SECRET"}]}}
#
# Multi-tenant BYOK example — each customer's own SignalHire account:
# SIGNALHIRE_TENANTS={"acme":{"signalhire_api_key_env":"ACME_SIGNALHIRE_KEY","adapters":[{"type":"webhook","name":"staffhive","url":"...","secret_env":"STAFFHIVE_RELAY_SECRET"},{"type":"mcp","name":"cats","server":"http://127.0.0.1:3000/mcp/","tool":"upsert_candidate_from_enrichment","auth_token_env":"CATS_MCP_TOKEN"}]}}
#
# Or point at a file instead:
# SIGNALHIRE_TENANTS_FILE=/etc/signalhire/tenants.json

# Secrets referenced by the config above:
# STAFFHIVE_RELAY_SECRET=...
# CATS_MCP_TOKEN=...
# ACME_SIGNALHIRE_KEY=...

# ============================================================================
# Delivery worker
# ============================================================================
# SIGNALHIRE_WORKER_ENABLED=true
# SIGNALHIRE_WORKER_POLL_SECONDS=2.0
# SIGNALHIRE_MAX_DELIVERY_ATTEMPTS=8
# SIGNALHIRE_BACKOFF_BASE_SECONDS=5.0
# SIGNALHIRE_MAX_BACKOFF_SECONDS=900.0

# ============================================================================
# Composition — expose another MCP server's tools through this endpoint
# ============================================================================
# Separate from delivery. This is for *discovery*: an agent connected here can
# also reach the mounted server's tools, namespaced. You may well want to write
# to CATS (via the adapter above) without exposing its 200 tools to whatever
# model is connected here.
# SIGNALHIRE_MOUNTS={"ats":"http://127.0.0.1:3000/mcp/"}

# ============================================================================
# Optional
# ============================================================================
# SIGNALHIRE_API_BASE_URL=https://www.signalhire.com
# SIGNALHIRE_API_PREFIX=/api/v1
# SIGNALHIRE_LOG_TIMING=true
# SIGNALHIRE_SKILLS_DIR=/etc/signalhire/skills
# LOG_LEVEL=INFO
