# SignalHire MCP Server - Git Ignore

# ============================================
# SECURITY: Environment Variables & Secrets
# ============================================
# CRITICAL: Never commit API keys or secrets!
.env
.env.local
.env.production
.env.development
.env.test
*.env
!.env.example
!.env.template

# API Keys and Secrets
*secret*
*credential*
*.key
*.pem

# ...but `*credential*` also matched the SOURCE package
# src/signalhire_mcp/credentials/, so four modules were never committed and
# a fresh clone could not import signalhire_mcp at all. Git cannot re-include
# a file whose parent directory is excluded, so the directory is un-excluded
# first and its contents second. These files are code -- the module that
# defines redaction -- not secrets.
!src/signalhire_mcp/credentials/
!src/signalhire_mcp/credentials/**

# ============================================
# PRIVACY: the durable callback inbox
# ============================================
# These directories hold raw SignalHire callback payloads — revealed personal
# email addresses and phone numbers for real people. They are operational
# state, never source, and must not reach a repository under any circumstances.
.signalhire-data/
signalhire-data/
var/lib/signalhire-mcp/
**/events/pending/
**/events/done/
**/events/failed/
*.p12
*.pfx

# Configuration with secrets
config.local.*
secrets.json
secrets.yaml
.secrets/

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ============================================
# Virtual Environments
# ============================================
venv/
env/
ENV/
.venv

